// ==============================================================================
// RETAIL SUPERSTORE DAX MEASURES SPECIFICATION
// Framework: RISK Methodology — Solution Development & Engineering
// Author: Vijay Maheswari
// Target Model: Star Schema (FactSales, DimProduct, DimCustomer, DimGeography, DimDate)
// ==============================================================================

// ------------------------------------------------------------------------------
// 1. CORE TRANSACTIONAL MEASURES
// ------------------------------------------------------------------------------

[Total Sales] = 
SUM(FactSales[Sales])
// Format: Currency ($#,##0.00)
// Description: Total gross invoiced sales revenue across all order lines.
// Reconciled Python Value: $2,297,200.86 (Variance: $0.00)

[Total Profit] = 
SUM(FactSales[Profit])
// Format: Currency ($#,##0.00)
// Description: Total net operational profit contribution.
// Reconciled Python Value: $286,397.02 (Variance: $0.00)

[Total Quantity] = 
SUM(FactSales[Quantity])
// Format: Whole Number (#,##0)
// Description: Aggregate physical unit count sold.
// Reconciled Python Value: 37,873 units (Variance: 0)

[Total Orders] = 
DISTINCTCOUNT(FactSales[Order ID])
// Format: Whole Number (#,##0)
// Description: Distinct count of unique customer orders placed.
// Reconciled Python Value: 5,009 orders (Variance: 0)

[Total Order Lines] = 
COUNTROWS(FactSales)
// Format: Whole Number (#,##0)
// Description: Total individual line items recorded.
// Reconciled Python Value: 9,994 lines (Variance: 0)

[Total Customers] = 
DISTINCTCOUNT(FactSales[Customer ID])
// Format: Whole Number (#,##0)
// Description: Total distinct transacting customer accounts.
// Reconciled Python Value: 793 customers (Variance: 0)


// ------------------------------------------------------------------------------
// 2. COMMERCIAL PERFORMANCE & PROFITABILITY RATIOS
// ------------------------------------------------------------------------------

[Profit Margin %] = 
DIVIDE([Total Profit], [Total Sales], 0)
// Format: Percentage (0.00%)
// Description: Enterprise operating profit margin percentage.
// Reconciled Python Value: 12.47% (Variance: 0.00%)

[Average Order Value] = 
DIVIDE([Total Sales], [Total Orders], 0)
// Format: Currency ($#,##0.00)
// Description: Average gross revenue captured per discrete order.
// Reconciled Python Value: $458.61 (Variance: $0.00)

[Average Basket Size] = 
DIVIDE([Total Quantity], [Total Orders], 0)
// Format: Decimal (0.0)
// Description: Average unit volume per customer transaction basket.
// Reconciled Python Value: 7.6 units/order (Variance: 0.0)

[Average Discount Rate] = 
AVERAGE(FactSales[Discount])
// Format: Percentage (0.00%)
// Description: Mean discount applied across transactional line items.
// Reconciled Python Value: 15.62% (Variance: 0.00%)


// ------------------------------------------------------------------------------
// 3. RISK DIAGNOSTICS & LOSS LEADER ISOLATION
// ------------------------------------------------------------------------------

[Negative Profit Loss] = 
CALCULATE(
    SUM(FactSales[Profit]),
    FactSales[Profit] < 0
)
// Format: Currency ($#,##0.00)
// Description: Cumulative net financial loss incurred by unprofitable order lines.
// Reconciled Python Value: -$156,131.29 (Variance: $0.00)

[Negative Profit Line Count] = 
CALCULATE(
    COUNTROWS(FactSales),
    FactSales[Profit] < 0
)
// Format: Whole Number (#,##0)
// Description: Number of transactions sold below operational break-even.
// Reconciled Python Value: 1,871 lines (Variance: 0)

[High Discount Sales] = 
CALCULATE(
    [Total Sales],
    FactSales[Discount] > 0.20
)
// Format: Currency ($#,##0.00)
// Description: Revenue generated by transactions with discounts exceeding 20%.
// Reconciled Python Value: $362,770.12 (Variance: $0.00)

[High Discount Loss] = 
CALCULATE(
    [Total Profit],
    FactSales[Discount] > 0.20
)
// Format: Currency ($#,##0.00)
// Description: Operating loss generated by transactions with discounts > 20%.
// Reconciled Python Value: -$135,376.06 (Variance: $0.00)


// ------------------------------------------------------------------------------
// 4. TIME INTELLIGENCE & PERIOD-OVER-PERIOD ANALYSIS
// ------------------------------------------------------------------------------

[Sales YTD] = 
TOTALYTD(
    [Total Sales],
    DimDate[Date]
)
// Format: Currency ($#,##0.00)
// Description: Year-to-date cumulative revenue.

[Profit YTD] = 
TOTALYTD(
    [Total Profit],
    DimDate[Date]
)
// Format: Currency ($#,##0.00)
// Description: Year-to-date cumulative operating profit.

[Sales Prior Year] = 
CALCULATE(
    [Total Sales],
    SAMEPERIODLASTYEAR(DimDate[Date])
)
// Format: Currency ($#,##0.00)
// Description: Total revenue achieved in the corresponding prior-year period.

[Sales YoY Growth $] = 
[Total Sales] - [Sales Prior Year]
// Format: Currency ($#,##0.00)
// Description: Absolute dollar revenue expansion vs prior year.

[Sales YoY Growth %] = 
DIVIDE([Sales YoY Growth $], [Sales Prior Year], 0)
// Format: Percentage (0.00%)
// Description: Percentage revenue expansion rate vs prior year.
